# PostHog — copy to .env.local for local tests.
# Production: set these in the Vercel project settings.
# Analytics only runs when NODE_ENV=production (Vite production build).

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Vite also reads VITE_ keys if you prefer that prefix:
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://app.posthog.com
