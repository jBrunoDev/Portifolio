# PostHog — copy to .env.local for local tests.
# Production: set these in the Vercel project settings.
# Analytics only runs on a production build.

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Names from the PostHog Vite docs also work:
# VITE_POSTHOG_PROJECT_TOKEN=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
